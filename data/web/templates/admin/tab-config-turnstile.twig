<div class="tab-pane fade" id="tab-config-turnstile" role="tabpanel" aria-labelledby="tab-config-turnstile">
  <div class="card mb-4">
    <div class="card-header d-flex fs-5">
      <button class="btn d-md-none flex-grow-1 text-start" data-bs-target="#collapse-tab-config-turnstile" data-bs-toggle="collapse" aria-controls="collapse-tab-config-turnstile">Cloudflare Turnstile</button>
      <span class="d-none d-md-block">Cloudflare Turnstile</span>
    </div>
    <div id="collapse-tab-config-turnstile" class="card-body collapse" data-bs-parent="#admin-content">
      <p>{{ lang.admin.turnstile_hint }}</p>
      <form method="post" autocomplete="off">
        <div class="row mb-3">
          <label class="col-sm-3 col-form-label" for="turnstile_site_key">{{ lang.admin.turnstile_site_key }}</label>
          <div class="col-sm-9">
            <input class="form-control" type="text" id="turnstile_site_key" name="turnstile_site_key" value="{{ turnstile_settings.site_key }}" maxlength="256">
          </div>
        </div>
        <div class="row mb-3">
          <label class="col-sm-3 col-form-label" for="turnstile_secret_key">{{ lang.admin.turnstile_secret_key }}</label>
          <div class="col-sm-9">
            <input class="form-control" type="password" id="turnstile_secret_key" name="turnstile_secret_key" autocomplete="new-password" maxlength="256">
            {% if turnstile_settings.has_secret %}<small class="text-muted">{{ lang.admin.turnstile_secret_saved }}</small>{% endif %}
          </div>
        </div>
        <div class="form-check mb-3">
          <input class="form-check-input" type="checkbox" id="turnstile_clear" name="turnstile_clear" value="1">
          <label class="form-check-label" for="turnstile_clear">{{ lang.admin.turnstile_clear }}</label>
        </div>
        <button type="submit" name="save_turnstile" class="btn btn-success">{{ lang.admin.save }}</button>
      </form>
    </div>
  </div>
</div>